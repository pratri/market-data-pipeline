# Copy to .env.airflow and fill in. Gitignored; this example is not.
#
# Separate from the project's .env: Docker Compose reads THIS file for
# variable substitution in docker-compose.yaml.

# Encrypts connection passwords and variables stored in Airflow's DB.
#   docker run --rm apache/airflow:3.0.2 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=paste-generated-key-here

# Signs the tokens workers use to authenticate to the API server. Must
# be the same across every container or tasks hang in `queued`.
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=paste-generated-hex-here

# From: cd terraform && terraform output s3_bucket_name
S3_BUCKET=market-data-pipeline-raw-xxxxxxxx
AWS_REGION=us-east-1

# SEC blocks requests that don't identify the caller.
SEC_USER_AGENT=Your Name your-email@domain.com

# Host user ID, so files in mounted volumes aren't root-owned.
# Linux: set to `id -u` (usually 1000). Windows: leave 50000.
AIRFLOW_UID=50000
