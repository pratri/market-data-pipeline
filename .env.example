# Copy to .env and fill in your own values.
# .env is gitignored; this example file is not.

# Bucket created by Terraform. Get it with:
#   cd terraform && terraform output s3_bucket_name
S3_BUCKET=market-data-pipeline-raw-xxxxxxxx

AWS_REGION=us-east-1

# SEC requires a real name and email or it blocks your requests.
SEC_USER_AGENT=Your Name your-email@domain.com
