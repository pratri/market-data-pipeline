# Copy to ~/.dbt/profiles.yml (C:\Users\Pranav\.dbt\profiles.yml on Windows).

market_data:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: idc24001.us-east-1
      user: pranteja
      password: @@@No1gaadidha
      role: ACCOUNTADMIN
      database: MARKET_DATA
      warehouse: MARKET_WH

      # dbt adds a suffix per layer: ANALYTICS_STAGING, _INTERMEDIATE, _MARTS
      schema: ANALYTICS

      # more than 4 just queues on XSMALL
      threads: 4

      client_session_keep_alive: false
