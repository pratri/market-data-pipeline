# Copy this to ~/.dbt/profiles.yml (create the .dbt folder if needed).
# On Windows that path is C:\Users\Pranav\.dbt\profiles.yml
#
# This file lives OUTSIDE the repo so credentials are never committed.
# That's why it's included here only as an example.

market_data:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: idc24001.us-east-1
      user: pranteja
      password: @@@No1gaadidha
      role: ACCOUNTADMIN
      database: MARKET_DATA
      warehouse: MARKET_WH

      # dbt writes into this schema. The dbt_project.yml config appends
      # a suffix per layer, so models land in ANALYTICS_staging,
      # ANALYTICS_intermediate, ANALYTICS_marts.
      schema: ANALYTICS

      # Parallel model builds. 4 is comfortable on an XSMALL warehouse;
      # higher just queues.
      threads: 4

      client_session_keep_alive: false
